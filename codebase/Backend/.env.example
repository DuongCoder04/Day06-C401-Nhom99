AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional: switch to OpenAI instead of Gemini
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# External tools (optional — falls back gracefully if not set)
# Weather: https://openweathermap.org/api (free tier: 1000 calls/day)
OPENWEATHERMAP_API_KEY=your-owm-key-here

# Web search: https://tavily.com (free tier: 1000 calls/month)
TAVILY_API_KEY=your-tavily-key-here

# CORS: comma-separated list of allowed origins (defaults to localhost dev ports)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com
